# Configuration File - Copy this to .env and fill in your actual values
# The script will automatically detect which configuration you're using

# === OPTION 1: Direct OpenAI ===
# Set OPENAI_MODEL and OPENAI_API_KEY to use OpenAI directly
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.2

# === OPTION 2: Azure AI Foundry ===
# Set FOUNDRY_MODEL_ENDPOINT, DEPLOYMENT_NAME, and OPENAI_API_KEY to use Azure
# FOUNDRY_MODEL_ENDPOINT=https://your-foundry-endpoint.openai.azure.com/openai/v1
# DEPLOYMENT_NAME=gpt-oss-120b
# OPENAI_API_KEY=your-azure-api-key-here
