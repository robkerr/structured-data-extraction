# Azure AI Foundry Configuration
# Copy this file to .env and fill in your actual values

# The base URL for your Azure AI Foundry endpoint
# Example: https://foundry-yourname.openai.azure.com/openai/v1
FOUNDRY_MODEL_ENDPOINT=https://your-foundry-endpoint.openai.azure.com/openai/v1

# Your Azure OpenAI API key
# Get this from your Azure AI Foundry portal
OPENAI_API_KEY=your-api-key-here

# The name of your deployed model
# This should match the deployment name in Azure AI Foundry
DEPLOYMENT_NAME=gpt-oss-120b
